---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import MyImage from "../../public/images/yanxiang.webp";
import { Icon } from "astro-icon/components";
import Skill from "../components/Skill.astro";
import News from "../components/News.astro";
import RecentPaper from "../components/RecentPaper.astro";
---

<Layout title="Yanxiang Wang | Homepage">
  <div class="mx-auto max-w-screen-lg px-4 py-6 sm:px-6 sm:py-10 lg:px-8">
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-8"
    >
      <div class="flex justify-center sm:justify-end">
        <Image src={MyImage} alt="Yanxiang Wang" class="w-40 sm:w-48 rounded" />
      </div>
      <div class="text-center sm:text-left max-w-md">
        <h1 class="text-3xl sm:text-4xl font-bold">Yanxiang Wang</h1>
        <div class="mt-4 space-y-2">
          <p class="text-lg">Associate Professor</p>
          <p class="text-lg">
            <a
              href="https://www.sdu.edu.cn/"
              class="link">Shandong University</a
            >
          </p>
          <p class="text-lg">
            <span class="font-bold">Email</span>: yanxiang.wang [AT] sdu.edu.cn
          </p>
          <div class="flex justify-center sm:justify-start space-x-4 mt-4">
            <a
              href="https://github.com/yanxiang-wang"
              title="Github"
              class="p-1"
            >
              <Icon name="mdi:github" class="w-7 h-7 hover:text-sky-500" />
            </a>
            <a
              href="https://scholar.google.com/citations?user=v0iZQ2cAAAAJ&hl=en"
              title="Google Scholar"
              class="p-1"
            >
              <Icon
                name="academicons:google-scholar-square"
                class="w-7 h-7 hover:text-sky-500"
              />
            </a>
            <a
              href="https://orcid.org/0000-0002-1466-4006"
              title="Orcid"
              class="p-1"
            >
              <Icon
                name="academicons:orcid"
                class="w-7 h-7 hover:text-sky-500"
              />
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-2">
      <nav aria-label="Main navigation" class="my-6 border-y border-gray-200 py-3">
        <ul class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 sm:gap-x-4">
          <li><a href="/publications" class="menu-link">Publications</a></li>
          <li><a href="/awards" class="menu-link">Awards</a></li>
          <li><a href="/teaching_service" class="menu-link">Teaching &amp; Services</a></li>
          <li><a href="/misc" class="menu-link">Misc</a></li>
        </ul>
      </nav>

      <div class="space-y-3 pt-2">
        <p class="text-lg leading-relaxed">
          I am an Associate Professor at
          <a href="https://www.sdu.edu.cn/" class="link">Shandong University</a>,
          China. My research interests include mobile computing, machine learning,
          and computer vision.
        </p>
        <p class="text-lg leading-relaxed">
          Previously, I conducted my doctoral research at the
          <a href="https://www.unsw.edu.au/" class="link">University of New South Wales</a>
          (UNSW), Australia, and worked at DATA61-CSIRO. I received my M.Eng from
          <a href="https://english.hrbeu.edu.cn/" class="link">Harbin Engineering University</a>
          and my B.Sec from
          <a href="https://www.jlu.edu.cn/" class="link">Jilin University</a>.
        </p>
      </div>
      <RecentPaper />
      <div class="mt-8 space-y-6 border-t border-gray-200 pt-4">
        <News />
        <Skill />
      </div>
    </div>
    <footer class="text-right mt-4">
      <div class="w-full mx-auto">
        <!-- <div class="flex items-center justify-center gap-2">
          <p class="text-sm text-gray-500 flex items-center">
            Sponsored by <a
              href="https://www.yxvm.com/"
              class="inline-flex items-center hover:opacity-80 ml-1"
            >
              <img src="/images/yxvm.svg" alt="YXVM" class="w-40" />
            </a>
          </p>
        </div> -->
      </div>
      <p class="text-base">Last update: October 2026</p>
    </footer>
  </div>
</Layout>

<style>
  .menu-link {
    @apply inline-flex min-h-11 items-center whitespace-nowrap rounded-md px-3 py-2 text-base font-semibold text-blue-600 transition-colors hover:bg-blue-50 hover:text-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:text-lg;
  }
</style>
