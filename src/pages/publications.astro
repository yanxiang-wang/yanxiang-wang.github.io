    <div class="mx-2">
      <h1 class="font-bold text-4xl">Publications</h1>
      <ul class="list-disc mt-2 ml-6 space-y-1">
        <li>
          <Paper
            abbr={"IEEE IoTJ '24"}
            title={"VibMilk: Non-intrusive Milk Spoilage Detection via Smartphone Vibration."}
            fullname={"IEEE Internet of Things Journal"}
          >
            <p>
              Yuezhong Wu, Wei Song, <span class="font-bold underline"
                >Yanxiang Wang</span
              >, Dong Ma, Weitao Xu, Mahbub Hassan, Wen Hu
            </p>
          </Paper>
        </li>
        <li>
          <Paper
            abbr={"IPSN '24"}
            title={"LiDARSpectra: Indoor Spectral Mapping with Low-cost LiDARs"}
            fullname={"ACM/IEEE IPSN 2024"}
          >
            <p>
              Jiawei Hu, <span class="font-bold underline">Yanxiang Wang</span>,
              Hong Jia, Cheng Jiang, Mahbub Hassan, Brano Kusy, Wen Hu
            </p>
          </Paper>
        </li>
        <li>
          <Paper
            abbr={"IMWUT/UbiComp '23"}
