        <li>
          <Paper
            abbr={"IMWUT/UbiComp '23"}
            title={"Spectral-Loc: Indoor Localization using Light Spectral Information"}
            fullname={"ACM UbiComp 2023"}
          >
            <p class="author">
              <span class="font-bold underline">Yanxiang Wang</span>, Jiawei Hu,
              Hong Jia, Ashraf Uddin, Kusy, Brano, Moustafa Youssef, Mahbub
              Hassan, Wen Hu
            </p>
          </Paper>
        </li>
        <li>
          <Paper
            abbr={"TPAMI '21"}
