---
import Paper from "../components/Paper.astro";
import Layout from "../layouts/Layout.astro";
import publications from "../data/publications.json";
const years = [...new Set(publications.papers.map((paper) => paper.year))].sort((a, b) => b - a);
---

<Layout title="Yanxiang Wang | Publications">
  <main class="mx-auto max-w-screen-md my-10 px-4 sm:px-6">
    <a href="/" class="link">&larr; Home</a>
    <h1 class="font-bold text-4xl mt-4">Publications</h1>
    <p class="mt-3 text-gray-600">
      Publication records from <a href={publications.scholarUrl} class="link">Google Scholar</a>,
      checked on <time datetime={publications.checkedAt}>October 23, 2026</time>.
    </p>
    {years.map((year) => (
      <section class="mt-8" aria-labelledby={`publications-${year}`}>
        <h2 id={`publications-${year}`} class="font-bold text-2xl border-b border-gray-200 pb-2">{year}</h2>
        <ul class="list-disc mt-4 ml-6 space-y-5">
          {publications.papers.filter((paper) => paper.year === year).map((paper) => (
            <li>
              <Paper abbr={paper.abbr} title={paper.title} fullname={paper.venue} authors={paper.authors} url={paper.url} preprint={paper.preprint} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Layout>
