---
import "@fontsource/lato";
import "@fontsource/jost";

import Layout from "../layouts/Layout.astro";
import HomeLink from "../components/HomeLink.astro";
---

<Layout title="Yanxiang Wang | Awards and Honors">
  <div class="mx-auto max-w-screen-md mt-10">
    <div class="mx-2">
      <HomeLink />
      <h1 class="font-bold text-4xl">Awards and Honors</h1>
      <ul class="list-disc mt-2 ml-6 space-y-1">
        <li>Best Demo Runner-Up Award at ACM SenSys, 2026</li>
        <li>Best Paper Runner-up Award at ACM/IEEE IPSN, 2024</li>
        <li>
          Google Ph.D. Fellowship Nominee, Australia, 2023 (1 out of 2 from
          UNSW)
        </li>
        <li>
          Participant in the ACM Student Research Competition (SRC), ACM
          Sigcomm, 2023 (6 out of 36)
        </li>
        <li>Student Travel Grant, ACM Sigcomm, 2023</li>
        <li>Best Poster Runner-up Award at ACM Mobicom, 2022</li>
        <li>DATA61 & CSIRO Top-up Scholarship, 2021 - 2024</li>
        <li>UNSW Scientia PhD Scholarship, 2021 - 2025</li>
        <li>Harbin Engineering University Second Prize Scholarship, 2018</li>
        <li>Harbin Engineering University First Prize Scholarship, 2017</li>
      </ul>
    </div>
  </div>
</Layout>
