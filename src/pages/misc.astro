---
import Layout from "../layouts/Layout.astro";

const adviceLinks = [
  {
    href: "https://karpathy.github.io/2016/09/07/phd/",
    text: "A Survival Guide to a PhD",
  },
  {
    href: "https://home.ttic.edu/~kgimpel/etc/phd-advice.pdf",
    text: "Kevin Gimpel's PhD advice",
  },
  {
    href: "https://journals.plos.org/ploscompbiol/article?id=10.1371/journal.pcbi.1005730",
    text: "Ten simple rules for writing a response to reviewers",
  },
  {
    href: "https://people.cs.umass.edu/~wallach/how_to_be_a_successful_phd_student.pdf",
    text: "How to Be a Successful PhD Student (in Computer Science (in NLP/ML))",
  },
  {
    href: "https://bigaidream.gitbooks.io/tech-blog/content/2014/de-mystifying-good-research.html?ref=ruder.io",
    text: "Fei-Fei Li's advice on Good Research and Good Papers",
  },
  {
    href: "https://phyletica.org/matplotlib-fonts/",
    text: "How to change the font used in matplotlib",
  },
  {
    href: "https://stackoverflow.com/questions/614619/how-to-find-out-which-fonts-are-referenced-and-which-are-embedded-in-a-pdf-docum",
    text: "Make sure all fonts are embedded in the document",
  },
  {
    href: "https://www.cesarsotovalero.net/blog/how-to-write-a-good-paper-rebuttal.html",
    text: "How to Write a Good Paper Rebuttal",
  },
  {
    href: "https://alexplescan.com/posts/2024/08/10/wezterm/",
    text: "Okay, I really like WezTerm",
  },
  {
    href: "https://github.com/yanxiang-wang/pdf-type3-font-detector",
    text: "PDF Type 3 Font Detector",
  },
  {
    href: "https://ccfddl.com/",
    text: "CCF Rec. Conference Deadlines",
  },
  {
    href: "/vps",
    text: "VPS Testing Scripts and Notes",
  },
  {
    href: "https://bookdown.org/yufree/sciguide/",
    text: "Modern Research Guide",
  },
  {
    href: "https://blog.einverne.info/post/2024/01/adguard-home-53-port-systemd-resolve.html",
    text: "AdGuard Home 53 Port Systemd Resolve",
  },
  {
    href: "/rebuttal",
    text: "Rebuttal Guide by Frédo Durand",
  },
  {
    href: "https://simon.peytonjones.org/great-research-paper/",
    text: "How to Write a Great Research Paper",
  },
  {
    href: "https://blog.liyiwei.org/style/",
    text: "Research suggestions given by Li-Yi Wei",
  },
  {
    href: "https://phdcomics.com/comics.php",
    text: "PhD Comics",
  },
];
---

<Layout title="Yanxiang Wang | Misc">
  <div class="mx-auto max-w-screen-md mt-10">
    <div class="mx-2">
      <h2 class="font-bold text-4xl">Advice & useful stuff</h2>
      <ul class="list-disc mt-2 ml-6">
        {
          adviceLinks.map(({ href, text }) => (
            <li>
              <a {href} class="link">
                {text}
              </a>
            </li>
          ))
        }
      </ul>
      <h2 class="font-bold text-4xl mt-4">Logos</h2>
      <p class="mt-2">Here are some logos I have designed.</p>
      <img
        src="/images/sigcomm_2024.svg"
        alt="Sigcomm 2024"
        class="mt-2 w-64 h-auto"
      />
    </div>
  </div>
</Layout>
