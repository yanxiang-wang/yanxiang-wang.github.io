---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Yanxiang Wang | Teaching and Services">
  <div class="mx-auto max-w-screen-md mt-10">
    <div class="mx-2">
      <h1 class="font-bold text-4xl">Teaching and Services</h1>
      <h2 class="font-bold text-2xl mt-4">Teaching</h2>
      <p class="mt-2">
        I have been a teaching assistant for the following courses at the
        University of New South Wales:
      </p>
      <ul class="list-disc mt-2 ml-6">
        <li>COMP3331/9331: Computer Networks and Applications, 2024, T3</li>
        <li>COMP3331/9331: Computer Networks and Applications, 2024, T2</li>
        <li>COMP3331/9331: Computer Networks and Applications, 2024, T1</li>
        <li>COMP3331/9331: Computer Networks and Applications, 2023, T3</li>
      </ul>
      <h2 class="font-bold text-2xl mt-4">Services</h2>
      <p class="mt-2 text-lg">
        <span
          class="inline-flex items-center rounded-md bg-green-100 px-1 font-medium text-green-700"
          >Editorial Service</span
        >:
      </p>
      <ul class="list-disc mt-2 ml-6">
        <li>
          Web Chair at <a href="https://pakdd2025.org/" class="link"
            >PAKDD 2025</a
          >
        </li>
        <li>
          Publicity/Web Chair at <a
            href="https://conferences.sigcomm.org/sigcomm/2024/"
            class="link">Sigcomm 2024</a
          >
        </li>
        <li>
          Web Chair at <a href="https://smart-wear.vercel.app/" class="link"
            >SmartWear Workshop 2022</a
          >
        </li>
      </ul>
      <p class="mt-2 text-lg">
        <span
          class="inline-flex items-center rounded-md bg-yellow-100 px-1 font-medium text-yellow-700"
          >Review Service</span
        >:
      </p>
      <ul class="list-disc ml-6 mt-2">
        <li>IMWUT/UbiComp</li>
        <li>TOSN</li>
        <li>PerCom</li>
      </ul>
    </div>
  </div>
</Layout>
