---
interface Props {
  abbr: string;
  title: string;
  fullname: string;
  authors: string[];
  url?: string;
  preprint?: boolean;
}

const { abbr, title, fullname, authors, url, preprint = false } = Astro.props;
---

<div>
  <div>
    <span
      class:list={[
        "inline-flex items-center rounded-md px-2 text-sm font-medium",
        preprint ? "bg-purple-100 text-purple-800" : "bg-green-100 text-green-700",
      ]}
      >{abbr}</span
    >
    {url ? <a href={url} class="link">{title}</a> : title}
  </div>
  <p>
    {authors.map((author, index) => (
      <Fragment>{index > 0 && ", "}<span class:list={{ "font-bold underline decoration-1 underline-offset-4 [text-decoration-skip-ink:none]": author === "Yanxiang Wang" }}>{author}</span></Fragment>
    ))}
  </p>
  <p>{fullname}</p>
</div>
