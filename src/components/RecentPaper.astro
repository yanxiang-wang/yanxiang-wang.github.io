---
import Paper from "./Paper.astro";
import publications from "../data/publications.json";
const recentPapers = publications.papers.slice(0, 4);
---

<section class="pt-4 w-full" aria-labelledby="recent-publications">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="recent-publications" class="font-bold text-2xl">Recent Publications</h2>
    <a href="/publications" class="link">All publications &rarr;</a>
  </div>
  <ul class="list-disc ml-6 mt-3 space-y-4">
    {recentPapers.map((paper) => (
      <li>
        <Paper abbr={paper.abbr} title={paper.title} fullname={paper.venue} authors={paper.authors} url={paper.url} preprint={paper.preprint} />
      </li>
    ))}
  </ul>
</section>
